# Database
DATABASE_URL="postgresql://user:password@localhost:5432/klinik?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Storage (default local dev, replace with S3-compatible in prod)
STORAGE_DRIVER="local"        # local | s3
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""              # signed URL base (optional)

# WhatsApp provider (placeholder, swap later)
WA_DRIVER="noop"              # noop | fonnte | wablas | meta | twilio
WA_API_TOKEN=""
WA_API_BASE_URL=""

# Clinic profile
CLINIC_NAME="Klinik Cantik"
CLINIC_TIMEZONE="Asia/Jakarta"
CLINIC_CURRENCY="IDR"
CLINIC_LOCALE_DEFAULT="id"
